{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frontend",
  "main": "worker.js",
  "compatibility_date": "2026-09-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Without this, static files (including "/") skip worker.js and its security headers
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "rankspyseo.xyz", "custom_domain": true }
  ]
}
